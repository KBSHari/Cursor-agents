{
  "name": "commit_read",
  "description": "Read one commit in an Origin-hosted repository. Choose a single view: metadata, files, or a bounded patch.",
  "arguments": {
    "type": "object",
    "properties": {
      "owner": {
        "type": "string",
        "description": "Origin namespace (owner) slug"
      },
      "name": {
        "type": "string",
        "description": "Origin repository name within that namespace"
      },
      "sha": {
        "type": "string"
      },
      "view": {
        "type": "string"
      },
      "pageSize": {
        "type": "number"
      },
      "pageToken": {
        "type": "string"
      },
      "startLine": {
        "type": "number"
      },
      "endLine": {
        "type": "number"
      }
    },
    "required": [
      "owner",
      "name",
      "sha",
      "view"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}